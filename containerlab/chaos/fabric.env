# fabric.env — single source of truth for the sparebox fabric's topology
# facts. Sourced by probe.sh, trial.sh, analyze.sh and (optionally, see
# inject-patch.md) inject.sh, so these maps can't drift apart the way
# hand-maintained copies in three scripts inevitably do. That drift is
# runbook lesson 2 applied to the tooling instead of the fabric.
#
# Every value below was confirmed against live state on 2026-09-15:
# loopbacks from `ip -4 -o addr show dev lo`, links from the deploy log,
# conn names from `ipsec status` on all six sidecars.

CLAB_PREFIX="${CLAB_PREFIX:-clab-sparebox-fabric}"

NODES=(r1-1 r1-2 r2-1 r2-2 r3-1 r3-2)

# The only addresses carried in BGP. Anything else as a probe source fails
# on the return path, which looks exactly like an outage and isn't one.
declare -A LOOPBACK=(
  [r1-1]=10.0.1.1 [r1-2]=10.0.1.2
  [r2-1]=10.0.2.1 [r2-2]=10.0.2.2
  [r3-1]=10.0.3.1 [r3-2]=10.0.3.2
)

declare -A REGION=(
  [r1-1]=region1 [r1-2]=region1
  [r2-1]=region2 [r2-2]=region2
  [r3-1]=region3 [r3-2]=region3
)

declare -A ASN=(
  [region1]=65001 [region2]=65002 [region3]=65003
)

# link name -> "nodeA:ifA nodeB:ifB"
declare -A LINKS=(
  [link12]="r1-2:eth2 r2-1:eth2"     # region1 <-> region2 transit (eBGP + IPsec)
  [link23]="r2-2:eth2 r3-1:eth2"     # region2 <-> region3 transit
  [link31]="r3-2:eth2 r1-1:eth2"     # region3 <-> region1 transit
  [link-r1]="r1-1:eth1 r1-2:eth1"    # region1 intra (OSPF + iBGP + LDP)
  [link-r2]="r2-1:eth1 r2-2:eth1"    # region2 intra
  [link-r3]="r3-1:eth1 r3-2:eth1"    # region3 intra
)

TRANSIT_LINKS=(link12 link23 link31)

# Observed path facts, from return-path TTLs on a healthy fabric. Recorded
# here because they decide which probe pair is meaningful for which fault,
# and because they are asymmetric in a way that is easy to forget:
#
#   r1-1 -> r1-2   1 hop  both ways        (intra-region, OSPF)
#   r1-1 -> r3-2   1 hop  both ways        (link31, symmetric)
#   r1-1 -> r2-2   3 hops both ways        (via link31, symmetric)
#   r1-1 -> r2-1   forward via link12 (2 hops), return via link23+link31
#                  (4 hops) — ASYMMETRIC
#   r1-1 -> r3-1   forward via link12+link23 (4 hops), return via link31
#                  (2 hops) — ASYMMETRIC
#
# A probe across an asymmetric pair measures whichever direction the fault
# happens to break, so record the pair with every result set.

