      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "100 * container_memory_usage_bytes{id=\"/\"} / on(instance,job) machine_memory_bytes",
