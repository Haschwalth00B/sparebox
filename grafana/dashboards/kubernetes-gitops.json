      "title": "Top Containers by CPU",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "topk(\n  10,\n  sum by (namespace, pod, container) (\n    rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\"}[5m])\n  )\n)",
          "legendFormat": "{{namespace}} / {{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
