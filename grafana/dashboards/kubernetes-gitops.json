      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, app, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=\"flux-controllers\"}[5m])))",
          "legendFormat": "{{app}} / {{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
