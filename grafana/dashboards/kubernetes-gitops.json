    {
      "id": 5,
      "type": "timeseries",
      "title": "Flux Reconciliation Rate",
      "description": "Reconciliation activity by Flux controller.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app, controller) (rate(controller_runtime_reconcile_total{job=\"flux-controllers\"}[5m]))",
          "legendFormat": "{{app}} / {{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
